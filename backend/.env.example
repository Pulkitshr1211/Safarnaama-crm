# ============================================================
# SAFARNAAMA HOLIDAYS CRM — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── ANTHROPIC / CLAUDE ──────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── SENDGRID ─────────────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG....

# Verified sender addresses in your SendGrid account
ENQUIRY_EMAIL=enquiry@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ─── SUPABASE ─────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (NOT anon key)

# ─── SERVER ───────────────────────────────────────────────────
PORT=3001

# Set to "production" when deploying — enables static React serving + CORS for same-origin
NODE_ENV=production

# Frontend origin for CORS (use * for open access, or set to your domain)
FRONTEND_URL=https://your-app.railway.app

# ─── SENDGRID INBOUND PARSE WEBHOOK ──────────────────────────
# A secret appended to the webhook URL for basic verification:
#   POST https://your-api.railway.app/webhook/inbound-email?secret=<value>
INBOUND_WEBHOOK_SECRET=change-me-to-something-random

# ─── AMADEUS FLIGHT API ───────────────────────────────────────
# Free sandbox: https://developers.amadeus.com → Self-Service → My Apps
# Test env: https://test.api.amadeus.com  |  Production: https://api.amadeus.com
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENV=test

# ─── TRIPJACK B2B TRAVEL API ──────────────────────────────────
# Get from your TripJack B2B dashboard → API Credentials
TRIPJACK_API_KEY=your_tripjack_api_key
TRIPJACK_ENV=test

# ─── SMS / WHATSAPP NOTIFICATIONS (optional) ──────────────────
# Provider: "msg91" | "fast2sms" | "none"
NOTIF_PROVIDER=none

# MSG91 (WhatsApp + SMS) — https://msg91.com
MSG91_AUTHKEY=
MSG91_SENDER_ID=SAFARN
MSG91_WA_INTEGRATED_NUMBER=
MSG91_WA_TEMPLATE_ID=

# Fast2SMS (SMS only) — https://www.fast2sms.com
FAST2SMS_API_KEY=
